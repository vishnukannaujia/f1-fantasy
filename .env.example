# Copy this file to .env and fill in your key. Never commit the real .env file.

# Required: get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for generation
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: LangSmith tracing (see .claude/skills/langsmith-trace). Since
# chains.py and team_builder.py already use LangChain's ChatAnthropic,
# tracing is automatic once these are set -- no code changes needed for
# those paths. Get a free key at https://smith.langchain.com/ (Settings ->
# API Keys). Leave LANGSMITH_TRACING unset/false to trace nothing (default).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=f1-fantasy
